<UserControl x:Class="PCL.MyColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" FocusVisualStyle="{x:Null}" d:DesignWidth="260">
    <StackPanel>
        <Grid x:Name="PanSv" Height="86" ClipToBounds="True" Cursor="Cross" Background="Transparent"
              MouseLeftButtonDown="PanSv_MouseDown" MouseMove="PanSv_MouseMove" MouseLeftButtonUp="PanSv_MouseUp">
            <Rectangle x:Name="RectHue" RadiusX="4" RadiusY="4" />
            <Rectangle RadiusX="4" RadiusY="4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle RadiusX="4" RadiusY="4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse x:Name="ThumbSv" Width="12" Height="12" Stroke="{StaticResource ColorBrushWhite}" StrokeThickness="2"
                     HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="3" Color="#80000000" ShadowDepth="0" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
        <Border x:Name="PanHue" Height="14" Margin="0,8,0,0" CornerRadius="7" Cursor="Hand"
                MouseLeftButtonDown="PanHue_MouseDown" MouseMove="PanHue_MouseMove" MouseLeftButtonUp="PanHue_MouseUp">
            <Grid>
                <Border CornerRadius="7">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Ellipse x:Name="ThumbHue" Width="14" Height="14" Stroke="{StaticResource ColorBrushWhite}"
                         StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="3" Color="#80000000" ShadowDepth="0" />
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>
        </Border>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="PanPreview" Width="26" Height="26" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource ColorBrushGray5}" />
            <local:MyTextBox x:Name="TextHex" Grid.Column="1" Height="26" Margin="8,0" FontSize="12"
                             MaxLength="7" HorizontalContentAlignment="Center" TextChanged="TextHex_TextChanged" />
            <local:MyButton x:Name="BtnReset" Grid.Column="2" Height="26" Padding="10,0"
                            Text="{DynamicResource Setup.Ui.Theme.Color.RestoreDefault}" Click="BtnReset_Click" />
        </Grid>
    </StackPanel>
</UserControl>
